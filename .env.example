# Connection string do Neon (Dashboard > Connect). Exemplo:
# postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# "false" só para Postgres local sem SSL
DB_SSL=true

JWT_SECRET=troque-por-um-segredo-longo
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=3000

# Conta admin criada pela migration SeedAdmin no primeiro deploy
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
